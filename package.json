{
  "name": "sefakta-remotion",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "remotion preview",
    "build:matrix2d": "remotion render MatrixEffect2D out/matrix-effect/matrix_effect_2d.mp4",
    "validate:facts": "node --no-warnings --experimental-strip-types scripts/validate-facts.ts",
    "validate:facts:online": "node --no-warnings --experimental-strip-types scripts/validate-facts.ts --publish --check-urls",
    "test:validator": "python3 scripts/tests/test_validator.py && python3 scripts/tests/test_urls.py",
    "doctor": "node --no-warnings --experimental-strip-types scripts/doctor.ts",
    "setup:whisper": "node --no-warnings --experimental-strip-types scripts/align-captions.ts --setup-only",
    "new:episode": "node --no-warnings --experimental-strip-types scripts/new-episode.ts",
    "vo": "node --env-file-if-exists=.env --no-warnings --experimental-strip-types scripts/vo-fish.ts",
    "align": "node --no-warnings --experimental-strip-types scripts/align-captions.ts",
    "check:episodes": "node --no-warnings --experimental-strip-types scripts/check-episodes.ts",
    "lint": "eslint src",
    "bundle": "remotion bundle --out-dir=build --log=error",
    "quality": "npm run validate:facts && npm run check:episodes && npm run lint && tsc --noEmit && npm run bundle",
    "check:publish": "npm run validate:facts:online && npm run check:episodes -- --publish",
    "build:pictogram": "remotion render FileDeletedPictogram out/file-deleted/file_deleted_pictogram.mp4"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.541",
    "@remotion/captions": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/google-fonts": "4.0.541",
    "@remotion/install-whisper-cpp": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.541",
    "@types/react": "^18.3.12",
    "eslint": "10.12.0",
    "typescript": "^5.6.3"
  }
}

# Buat API key di https://fish.audio/app/developers/ (jangan di-commit; .env ada di .gitignore)
FISH_AUDIO_API_KEY=
# Disarankan: id suara referensi agar narator konsisten antarvideo
FISH_AUDIO_REFERENCE_ID=
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_SPEED=1.1

# Ilustrasi (npm run image). Key: https://platform.agnes-ai.com/settings/apiKeys
AGNES_API_KEY=
AGNES_IMAGE_MODEL=agnes-image-2.5-flash
AGNES_IMAGE_SIZE=2K
AGNES_IMAGE_RATIO=9:16
